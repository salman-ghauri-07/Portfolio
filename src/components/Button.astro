---
interface Props {
  href?: string;
  target?: string;
}
const { href, target } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class="btn" href={href} target={target} rel={target === '_blank' ? 'noopener' : undefined}>
  <span class="btn-label"><slot /></span>
  <span class="btn-fill" aria-hidden="true"></span>
</Tag>

<style>
  .btn {
    position: relative;
    overflow: hidden;
    height: 48px;
    padding-inline: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font: 400 18px var(--font-anton);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--primary);
    color: var(--primary-fg);
    transition: transform 160ms var(--ease-out);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn-label {
    position: relative;
    z-index: 1;
  }
  /* white blob rises and fills the button; text stays dark on white (kept quirk) */
  .btn-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100%;
    background: #fff;
    border-radius: 50%;
    transform: translateY(200%) scale(1.5); /* translate % is the fill's own height = the button's */
    transition: transform 300ms var(--ease-out);
  }
  /* gated: touch fires a sticky :hover on tap, which left the button white */
  @media (hover: hover) and (pointer: fine) {
    .btn:hover .btn-fill {
      transform: translateY(0) scale(1.5);
    }
  }
</style>
